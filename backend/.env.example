# ==========================================
# SURAKSHA GRID — Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=https://suraksha-grid-one.vercel.app,http://localhost:5173

# SQLite Database File Path (relative to backend root or absolute)
DB_PATH=./data/suraksha_grid.sqlite

# Security & Authentication (Prepared for Phase 3.3)
# In production, use high-entropy random string (at least 32 characters)
JWT_SECRET=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=24h

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

